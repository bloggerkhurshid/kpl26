# Khoraghat Premier League (KPL) PHP API Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /backend/

    # Direct access protection for sensitive config files
    RewriteRule ^config/ - [F,L]
    RewriteRule ^sql/ - [F,L]
</IfModule>

# Set CORS headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Enable Gzip compression for high performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/plain text/html text/xml text/css application/javascript
</IfModule>

# Disable directory browsing
Options -Indexes
